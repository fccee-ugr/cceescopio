f <- list.files(".", pattern = "\\.(qmd|md|yml|cff|R|py)$", recursive = TRUE)
f <- f[!grepl("^docs/", f)]
f[sapply(f, function(x) any(grepl("jfmunozrosas", readLines(x, warn = FALSE), fixed = TRUE)))]
getwd()
length(f)
system("git remote set-url origin https://github.com/NOMBRE-ORG/cceescopio.git")
system("git remote set-url origin https://github.com/fccee-ugr/cceescopio.git")
